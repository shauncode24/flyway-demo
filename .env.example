# Copy to .env (git-ignored) to point the dashboard at the Supabase schemas instead of the local sandbox.
# Leave .env absent to use the local Docker Postgres.
PGHOST=aws-0-<region>.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.<project-ref>
PGPASSWORD=<your database password>
PGDATABASE=postgres
PG_SCHEMAS=true
PGSSL=true
